# Copy to .env and fill in real values. Never commit .env.

# Postgres
POSTGRES_DB=finreminder
POSTGRES_USER=finreminder
POSTGRES_PASSWORD=change-me-strong-password

# API
JWT_SECRET=change-me-long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-login-password
REMINDER_DAYS=7

# On the VPS, Traefik (already running) routes app.narukullapati.com -> web:80
# and issues the TLS cert via its letsencrypt resolver. No extra config needed.
